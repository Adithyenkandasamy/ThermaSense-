# ──────────────────────────────────────────────
# ThermaSense — Environment Configuration
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL / PostGIS
# Used by the FastAPI app (async driver via asyncpg)
DATABASE_URL=postgresql+asyncpg://thermasense:thermasense@localhost:5434/thermasense

# Used by Alembic only (sync driver via psycopg2)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://thermasense:thermasense@localhost:5434/thermasense

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=thermasense
POSTGRES_PASSWORD=thermasense
POSTGRES_DB=thermasense
POSTGRES_PORT=5434

# NASA FIRMS API key. FIRMS_MAP_KEY is the preferred name from the project brief.
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Optional LLM explanation layer. The application must work when this is blank.
LLM_API_KEY=

# Background ingestion interval.
INGEST_INTERVAL_MINUTES=10

# Demo region bounding box: Western US (California focus)
# xmin, ymin, xmax, ymax  (WGS84)
DEMO_BBOX_XMIN=-124.5
DEMO_BBOX_YMIN=32.5
DEMO_BBOX_XMAX=-114.0
DEMO_BBOX_YMAX=42.0
