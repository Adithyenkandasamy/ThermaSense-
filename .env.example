# ──────────────────────────────────────────────
# ThermaSense — Environment Configuration
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL / PostGIS
DATABASE_URL=postgresql+asyncpg://thermasense:thermasense@localhost:5434/thermasense
ALEMBIC_DATABASE_URL=postgresql+psycopg2://thermasense:thermasense@localhost:5434/thermasense

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=thermasense
POSTGRES_PASSWORD=thermasense
POSTGRES_DB=thermasense
POSTGRES_PORT=5434

# ──────────────────────────────────────────────
# NASA FIRMS API Key
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/
# Both variable names are accepted (FIRMS_MAP_KEY is preferred by docker-compose).
# If both are empty, the system falls back to deterministic demo data.
# ──────────────────────────────────────────────
FIRMS_MAP_KEY=
FIRMS_API_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT

# ──────────────────────────────────────────────
# Groq AI API Key
# Get a free key at: https://console.groq.com/keys
# Both variable names are accepted (LLM_API_KEY is preferred by docker-compose).
# If empty, the system uses a deterministic fallback (AI_MODE=FALLBACK).
# ──────────────────────────────────────────────
LLM_API_KEY=
GROQ_API_KEY=

# Background polling interval (minutes)
INGEST_INTERVAL_MINUTES=10

# Demo region bounding box: Western US (California focus)
# xmin, ymin, xmax, ymax (WGS84)
DEMO_BBOX_XMIN=-124.5
DEMO_BBOX_YMIN=32.5
DEMO_BBOX_XMAX=-114.0
DEMO_BBOX_YMAX=42.0
