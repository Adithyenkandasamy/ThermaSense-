# ──────────────────────────────────────────────
# ThermaSense — Environment Configuration
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL / PostGIS
# Used by the FastAPI app (async driver via asyncpg)
DATABASE_URL=postgresql+asyncpg://thermasense:thermasense@localhost:5433/thermasense

# Used by Alembic only (sync driver via psycopg2)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://thermasense:thermasense@localhost:5433/thermasense

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=thermasense
POSTGRES_PASSWORD=thermasense
POSTGRES_DB=thermasense
POSTGRES_PORT=5433

# NASA FIRMS API Key (Phase 3 — get free key at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_API_KEY=

# Demo region bounding box: Western US (California focus)
# xmin, ymin, xmax, ymax  (WGS84)
DEMO_BBOX_XMIN=-124.5
DEMO_BBOX_YMIN=32.5
DEMO_BBOX_XMAX=-114.0
DEMO_BBOX_YMAX=42.0
